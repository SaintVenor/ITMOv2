    {
      "parameters": {
        "jsCode": "const pr = $('PR identity and review key').first().json;\nconst responses = $input.all();\nconst hunks = [];\n\nfor (let i = 0; i < responses.length; i++) {\n  const file = $('Prepare files for context').itemMatching(i).json;\n  const blob = responses[i].json.body;\n\n  if (blob?.sha !== file.sha || blob.encoding !== 'base64' || typeof blob.content !== 'string') {\n    throw new Error('Не удалось получить содержимое файла: ' + file.filename);\n  }\n\n  const fileContent = Buffer.from(blob.content.replace(/\\s/g, ''), 'base64').toString('utf8');\n  let oldLine = 0;\n  let newLine = 0;\n  let block = null;\n\n  function saveBlock() {\n    if (!block?.anchor) return;\n    hunks.push({\n      hunk_id: hunks.length + 1,\n      path: file.filename,\n      patch: block.lines.join('\\n'),\n      file_patch: file.patch,\n      file_content: fileContent,\n      line: block.anchor.line,\n      side: block.anchor.side,\n    });\n  }\n\n  for (const line of file.patch.split('\\n')) {\n    const header = line.match(/^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n    if (header) {\n      saveBlock();\n      oldLine = Number(header[1]);\n      newLine = Number(header[2]);\n      block = { lines: [line], anchor: null };\n      continue;\n    }\n    if (!block) continue;\n    block.lines.push(line);\n\n    if (line.startsWith('+')) {\n      block.anchor = { line: newLine++, side: 'RIGHT' };\n    } else if (line.startsWith('-')) {\n      if (block.anchor?.side !== 'RIGHT') {\n        block.anchor = { line: oldLine, side: 'LEFT' };\n      }\n      oldLine++;\n    } else if (line.startsWith(' ')) {\n      oldLine++;\n      newLine++;\n    }\n  }\n  saveBlock();\n}\n\nreturn [{ json: {\n  hunks,\n  total_hunks: hunks.length,\n  kind: pr.kind,\n  model: pr.model,\n} }];"
      },
      "name": "Parse diff anchors",
      "type": "n8n-nodes-base.code",

    {
      "parameters": {
        "jsCode": "const pr = $('PR identity and review key').first().json;\nconst parsed = $('Parse diff anchors').first().json;\nconst answers = $input.all();\n\nif (answers.length !== parsed.total_hunks) {\n  throw new Error('Не для всех блоков получено ревью');\n}\n\nconst comments = [];\nconst cleanBlocks = [];\n\nfor (let i = 0; i < answers.length; i++) {\n  const hunk = $('One item per changed block').itemMatching(i).json.hunk;\n  const text = typeof answers[i].json.output === 'string'\n    ? answers[i].json.output.trim()\n    : '';\n\n  if (!text) throw new Error('Пустой ответ ИИ для блока ' + hunk.hunk_id);\n\n  if (/^замечаний\\s+нет[.!?]*$/i.test(text)) {\n    cleanBlocks.push(hunk);\n  } else {\n    comments.push({ path: hunk.path, line: hunk.line, side: hunk.side, body: text });\n  }\n}\n\nconst bodyLines = [\n  `AI review (${pr.model}). Проверено блоков: ${parsed.total_hunks}.`,\n];\n\nif (comments.length === 0) {\n  bodyLines.push('Замечаний не обнаружено.');\n} else {\n  bodyLines.push(`Найдено замечаний: ${comments.length}.`);\n  if (cleanBlocks.length > 0) {\n    bodyLines.push('Блоки без замечаний:');\n    for (const hunk of cleanBlocks) {\n      bodyLines.push(`- ${hunk.path}, блок ${hunk.hunk_id}`);\n    }\n  }\n}\n\nbodyLines.push('Результат сгенерирован ИИ и требует проверки человеком.');\n\nreturn [{ json: {\n  repo: pr.repo,\n  number: pr.number,\n  pr_id: pr.pr_id,\n  model: pr.model,\n  head_sha: pr.head_sha,\n  review_key: pr.review_key,\n  review_request: {\n    event: 'COMMENT',\n    commit_id: pr.head_sha,\n    body: bodyLines.join('\\n'),\n    comments,\n  },\n} }];"
      },
      "id": "15835f73-466b-41c6-9547-5b454ce7461d",
      "name": "Build inline review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        9952,
        2288
      ],
      "notes": "Формирует общее ревью: замечания привязывает к строкам, блоки без замечаний отмечает в общем тексте."
    },
    {
      "parameters": {
        "jsCode": "const pages = $input.all();\nconst result = [];\n\n\nfor (const page of pages) {\n  const files = Array.isArray(page.json.body) ? page.json.body : [page.json];\n  for (const file of files) {\n    if (!file.patch) continue;\n    if (!file.sha) throw new Error('Нет SHA файла: ' + file.filename);\n\n    result.push({ json: {\n      filename: file.filename,\n      sha: file.sha,\n      status: file.status,\n      patch: file.patch,\n    } });\n  }\n}\n\nreturn result;"
      },
